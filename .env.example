# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LEAD_DELIVERY_PROVIDER: "webhook" | "resend" | "mock_verified" | "none"
# If set to "none" or left empty, forms display a clear setup requirement
# and guide the user to call 24/7 dispatch directly at (240) 424-8226.
LEAD_DELIVERY_PROVIDER="mock_verified"

# DISPATCH_WEBHOOK_URL: Secure HTTPS webhook URL (Zapier, Make, CRM) for leads
DISPATCH_WEBHOOK_URL=""

# RESEND_API_KEY: Resend.com API key for transactional email dispatch
RESEND_API_KEY=""

# DISPATCH_NOTIFICATION_EMAIL: Staff email address where leads are forwarded
DISPATCH_NOTIFICATION_EMAIL="dispatch@lltowingautorepair.com"

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# If left empty, analytics runs in local development mode without sending third-party network requests.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: Google Search Console HTML tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
